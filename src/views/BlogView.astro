---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Illustration from '@/components/Illustration.astro';
import Icon from '@/components/Icon.astro';
import { formatDate, href, type Lang } from '@/i18n';
import { t } from '@/i18n/ui';
import { getPosts, postSlug } from '@/data/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const posts = await getPosts(lang);
---

<Base lang={lang} title={ui.blog.title} description={ui.blog.lead}>
  <div class="wrap">
    <header class="page-head page-head--art">
      <div>
        <p class="label">{ui.blog.label}</p>
        <h1>{ui.blog.title}</h1>
        <p class="lead">
          {ui.blog.lead}
          {ui.blog.note && <span class="note">{ui.blog.note}</span>}
        </p>
      </div>
      <div class="page-head__art">
        <Illustration name="writing" />
      </div>
    </header>

    <ul class="posts">
      {
        posts.map((post, i) => (
          <li data-reveal>
            <a class="post" href={href(lang, `/blog/${postSlug(post)}`)}>
              <div class="post__media">
                <Image
                  src={post.data.cover}
                  alt=""
                  width={720}
                  height={480}
                  layout="constrained"
                  fit="cover"
                  sizes="(min-width: 760px) 300px, (min-width: 560px) 92vw, 240px"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="post__body">
                <p class="label">
                  {formatDate(post.data.date, lang)} · {post.data.minutes} {ui.blog.min}
                </p>
                <h2>{post.data.title}</h2>
                <p class="post__desc">{post.data.description}</p>
                <ul class="tags">
                  {post.data.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </div>
              <Icon name="arrow-right" class="post__arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .note {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-3);
  }

  .posts {
    border-top: 1px solid var(--line);
  }

  .post {
    display: grid;
    gap: 1.25rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .post__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--media);
  }

  .post__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .post:hover .post__media :global(img) {
    transform: scale(1.035);
  }

  h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.375rem, 1.15rem + 1vw, 1.875rem);
    letter-spacing: -0.025em;
    line-height: 1.12;
    max-width: 26ch;
    transition: color 0.2s;
  }

  .post:hover h2 {
    color: var(--accent);
  }

  .post__desc {
    margin-top: 0.75rem;
    color: var(--ink-2);
    max-width: 38em;
  }

  .tags {
    margin-top: 1.25rem;
  }

  .post :global(.post__arrow) {
    display: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--ink-3);
    transition:
      transform 0.3s var(--ease),
      color 0.2s;
  }

  .post:hover :global(.post__arrow) {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* Phones: a compact row, small cover on the left and the title beside it. */
  @media (max-width: 559px) {
    .post {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 0.9rem;
      align-items: start;
      padding-block: 1.1rem;
    }

    .post__media {
      border-radius: 8px;
    }

    .post__body .label {
      font-size: 0.75rem;
    }

    h2 {
      margin-top: 0.2rem;
      font-size: 0.9875rem;
      letter-spacing: -0.015em;
      line-height: 1.3;
    }

    .post__desc {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
      margin-top: 0.25rem;
      font-size: 0.8125rem;
      line-height: 1.45;
    }

    .tags {
      display: none;
    }
  }

  @media (min-width: 760px) {
    .post {
      grid-template-columns: 18.75rem minmax(0, 1fr) auto;
      gap: 2.5rem;
      align-items: center;
    }

    .post :global(.post__arrow) {
      display: block;
    }
  }
</style>
