---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { formatDate, href, otherLang, type Lang } from '@/i18n';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';
import { hasTranslation, postSlug, type Post } from '@/data/blog';
import '@fontsource-variable/jetbrains-mono/index.css';
import '@/styles/prose.css';

interface Props {
  lang: Lang;
  post: Post;
}

const { lang, post } = Astro.props;
const ui = t(lang);
const slug = postSlug(post);
const { Content } = await render(post);
const url = new URL(href(lang, `/blog/${slug}`), site.url).href;
// When the other language has no version of this post, the language switch goes to its post list.
const translated = await hasTranslation(post, otherLang(lang));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  inLanguage: lang,
  image: new URL(post.data.cover.src, site.url).href,
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: url,
  keywords: post.data.tags.join(', '),
};
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover.src}
  type="article"
  translated={translated}
  altHref={translated ? undefined : href(otherLang(lang), '/blog')}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="wrap">
    <header class="post-head">
      <a class="arrow-link back" href={href(lang, '/blog')}>
        <Icon name="arrow-left" />
        {ui.blog.back}
      </a>
      <p class="label">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time> · {
          post.data.minutes
        } {ui.blog.minRead}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
    </header>

    <div class="cover">
      <Image
        src={post.data.cover}
        alt=""
        width={1600}
        height={900}
        layout="constrained"
        fit="cover"
        sizes="(min-width: 1000px) 928px, 94vw"
        loading="eager"
        priority
      />
    </div>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <ul class="tags">
        {post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
      <a class="arrow-link" href={href(lang, '/blog')}>
        {ui.blog.back}
        <Icon name="arrow-right" />
      </a>
    </footer>
  </article>
</Base>

<style>
  article {
    max-width: 58rem;
  }

  .post-head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }

  .back {
    margin-bottom: 2.5rem;
    color: var(--ink-2);
  }

  .back:hover :global(svg) {
    transform: translateX(-4px);
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 1.3rem + 3vw, 3.5rem);
    letter-spacing: -0.022em;
    line-height: 1.04;
    max-width: 22ch;
  }

  .lead {
    margin-top: 1.5rem;
  }

  .cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--media);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prose {
    max-width: 44rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .post-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    max-width: 44rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
</style>
