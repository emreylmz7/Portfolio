---
import Base from '@/layouts/Base.astro';
import Illustration from '@/components/Illustration.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import { type Lang } from '@/i18n';
import { t } from '@/i18n/ui';
import { professionalProjects, personalProjects } from '@/data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const twoUp = '(min-width: 1300px) 590px, (min-width: 640px) 46vw, (min-width: 560px) 100vw, 240px';
const threeUp = '(min-width: 1300px) 384px, (min-width: 1000px) 31vw, (min-width: 640px) 46vw, (min-width: 560px) 100vw, 240px';
---

<Base lang={lang} title={ui.projects.title} description={ui.projects.lead}>
  <div class="wrap">
    <header class="page-head page-head--art">
      <div>
        <p class="label">{ui.projects.label}</p>
        <h1>{ui.projects.title}</h1>
        <p class="lead">{ui.projects.lead}</p>
      </div>
      <div class="page-head__art">
        <Illustration name="windows" />
      </div>
    </header>

    <!-- Products and client work come first, in large cards. -->
    <section class="group">
      <SectionHead title={ui.projects.professionalTitle} />
      <div class="grid grid--two">
        {professionalProjects.map((project, i) => <ProjectCard project={project} lang={lang} eager={i < 2} sizes={twoUp} row />)}
      </div>
    </section>

    <!-- Personal and open-source projects, in smaller cards. -->
    <section class="group">
      <SectionHead title={ui.projects.personalTitle} />
      <div class="grid grid--three">
        {personalProjects.map((project) => <ProjectCard project={project} lang={lang} sizes={threeUp} row />)}
      </div>
    </section>
  </div>
</Base>

<style>
  .group {
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .group + .group {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  .grid {
    display: grid;
    gap: 3rem 2rem;
  }

  /* Phones: compact rows, so the list stays short. */
  @media (max-width: 559px) {
    .grid {
      gap: 0.75rem;
    }

    .group + .group {
      margin-top: 2.5rem;
    }
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .grid--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 1.75rem;
    }
  }
</style>
