---
import Icon from './Icon.astro';
import { type Lang } from '@/i18n';
import { t } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const steps = t(lang).process;
const icons = ['chat', 'file', 'code', 'rocket'] as const;
---

<ol class="steps">
  {
    steps.map((step, i) => (
      <li class="step" data-reveal style={`--reveal-delay:${i * 80}ms`}>
        <div class="step__top">
          <span class="icon-tile">
            <Icon name={icons[i]} />
          </span>
          <span class="step__line" aria-hidden="true" />
        </div>
        <p class="step__num">0{i + 1}</p>
        <h3>{step.title}</h3>
        <p class="step__text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: 2.25rem 1.5rem;
  }

  .step__top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Dashed connector from one step's icon to the next. */
  .step__line {
    display: none;
    flex: 1;
    height: 0;
    margin-right: -0.5rem;
    border-top: 1.5px dashed var(--line);
  }

  .step__num {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  h3 {
    margin-top: 0.35rem;
    font-size: 1.1875rem;
    letter-spacing: -0.015em;
  }

  .step__text {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: 0.9875rem;
    line-height: 1.55;
  }

  /* Phones: a vertical timeline, icon on the left and a dashed line down to the next step. */
  @media (max-width: 599px) {
    .steps {
      gap: 0;
    }

    .step {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1rem;
    }

    .step__top {
      grid-row: 1 / span 3;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .step:not(:last-child) .step__line {
      display: block;
      width: 0;
      height: auto;
      margin: 0 0 0.5rem;
      border-top: 0;
      border-left: 1.5px dashed var(--line);
    }

    .step__top {
      gap: 0.4rem;
    }

    .icon-tile {
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 10px;
    }

    .icon-tile :global(svg) {
      width: 1.1rem;
      height: 1.1rem;
    }

    .step__num {
      margin-top: 0.05rem;
      font-size: 0.75rem;
    }

    h3 {
      margin-top: 0.15rem;
      font-size: 1rem;
    }

    .step__text {
      margin-top: 0.3rem;
      padding-bottom: 1.25rem;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .step:last-child .step__text {
      padding-bottom: 0;
    }
  }

  @media (min-width: 600px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .step:not(:last-child) .step__line {
      display: block;
    }
  }
</style>
