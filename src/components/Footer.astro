---
import Icon from './Icon.astro';
import { href, type Lang } from '@/i18n';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();

const nav = [
  { label: ui.nav.work, path: '/projects' },
  { label: ui.nav.services, path: '/services' },
  { label: ui.nav.about, path: '/about' },
  { label: ui.nav.writing, path: '/blog' },
  { label: ui.nav.contact, path: '/contact' },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="footer__name">{site.name}</p>
        <p class="footer__tagline">{ui.footer.tagline}</p>
      </div>

      <nav class="footer__col footer__col--nav" aria-label={ui.nav.menu}>
        {nav.map((item) => <a href={href(lang, item.path)}>{item.label}</a>)}
      </nav>

      <div class="footer__col">
        <a href={`mailto:${site.email}`}>
          <Icon name="mail" />
          {site.email}
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener">
          <Icon name="linkedin" />
          LinkedIn
        </a>
        <a href={site.github} target="_blank" rel="noopener">
          <Icon name="github" />
          GitHub
        </a>
      </div>
    </div>

    <div class="footer__bottom label">
      <span>© {year} {site.name}. {ui.footer.rights}</span>
      <span lang="tr">{site.location[lang]}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
    margin-top: clamp(3rem, 8vw, 7rem);
  }

  .footer__top {
    display: grid;
    gap: 2.5rem;
  }

  .footer__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: -0.025em;
  }

  .footer__tagline {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    max-width: 26em;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.9375rem;
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  .footer__col a:hover {
    color: var(--accent);
  }

  .footer__col :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  /* Phones: menu links in two columns instead of one long list. */
  @media (max-width: 759px) {
    .footer__top {
      gap: 2rem;
    }

    .footer__col--nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem 1.5rem;
    }

    .footer__bottom {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (min-width: 760px) {
    .footer__top {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.2fr);
    }
  }
</style>
