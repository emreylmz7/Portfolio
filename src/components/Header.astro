---
import Icon from './Icon.astro';
import { href, barePath, otherLang, type Lang } from '@/i18n';
import { t } from '@/i18n/ui';
import { site } from '@/data/site';

interface Props {
  lang: Lang;
  /** Override for the language switch when the page has no direct translation. */
  altHref?: string;
}

const { lang, altHref } = Astro.props;
const ui = t(lang);
const path = barePath(Astro.url.pathname);
const other = otherLang(lang);
const switchHref = altHref ?? href(other, path);

const items = [
  { label: ui.nav.work, path: '/projects' },
  { label: ui.nav.services, path: '/services' },
  { label: ui.nav.about, path: '/about' },
  { label: ui.nav.writing, path: '/blog' },
  { label: ui.nav.contact, path: '/contact' },
];

const isActive = (p: string) => path === p || path.startsWith(`${p}/`);
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={href(lang, '/')} aria-label={site.name}>
      <svg class="brand__mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
        <rect class="brand__bg" width="32" height="32" rx="9"></rect>
        <path
          class="brand__v"
          d="M9 10.5 16 22l4.2-6.9"
          fill="none"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <circle class="brand__dot" cx="23" cy="10.5" r="2.4"></circle>
      </svg>
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="nav" aria-label={ui.nav.menu}>
      {
        items.map((item) => (
          <a
            href={href(lang, item.path)}
            class:list={['nav__link', { 'is-active': isActive(item.path) }]}
            aria-current={isActive(item.path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <a class="tool lang" href={switchHref} hreflang={other} lang={other} title={ui.nav.langSwitch}>
        <span aria-hidden="true">{ui.nav.langSwitchShort}</span>
        <span class="sr-only">{ui.nav.langSwitch}</span>
      </a>
      <button class="tool theme" type="button" data-theme-toggle aria-label={ui.nav.theme}>
        <Icon name="moon" class="theme__moon" />
        <Icon name="sun" class="theme__sun" />
      </button>
      <a class="btn btn--primary btn--sm cta" href={href(lang, '/contact')}>{ui.nav.cta}</a>
      <button
        class="tool menu-btn"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={ui.nav.menu}
      >
        <Icon name="menu" class="menu-btn__open" />
        <Icon name="close" class="menu-btn__close" />
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" hidden>
    <nav class="wrap mobile__inner" aria-label={ui.nav.menu}>
      {
        items.map((item, i) => (
          <a
            href={href(lang, item.path)}
            class:list={['mobile__link', { 'is-active': isActive(item.path) }]}
            aria-current={isActive(item.path) ? 'page' : undefined}
          >
            <span class="label">0{i + 1}</span>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--primary mobile__cta" href={href(lang, '/contact')}>
        {ui.nav.cta}
        <Icon name="arrow-right" />
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    border-bottom-color: var(--line);
  }

  .site-header.is-open {
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    margin-right: auto;
    white-space: nowrap;
  }

  .brand__mark {
    flex: none;
  }

  .brand__bg {
    fill: var(--inv-bg);
  }

  .brand__v {
    stroke: var(--inv-ink);
  }

  .brand__dot {
    fill: var(--inv-accent);
  }

  .nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  .nav__link {
    position: relative;
    padding: 0.5rem 0.8rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-2);
    border-radius: 8px;
    transition: color 0.2s;
  }

  .nav__link:hover,
  .nav__link.is-active {
    color: var(--ink);
  }

  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .tool {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .tool:hover {
    background: var(--media);
    color: var(--ink);
  }

  .tool :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .lang {
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .theme :global(.theme__sun),
  :global([data-theme='dark']) .theme :global(.theme__moon) {
    display: none;
  }

  :global([data-theme='dark']) .theme :global(.theme__sun) {
    display: block;
  }

  .cta {
    display: none;
    margin-left: 0.5rem;
  }

  .menu-btn :global(.menu-btn__close),
  .is-open .menu-btn :global(.menu-btn__open) {
    display: none;
  }

  .is-open .menu-btn :global(.menu-btn__close) {
    display: block;
  }

  .mobile {
    border-top: 1px solid var(--line);
    background: var(--bg);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }

  .mobile__inner {
    display: flex;
    flex-direction: column;
    padding-block: 0.25rem 1.25rem;
  }

  .mobile__link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.0625rem;
    font-weight: 550;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  /* Fixed-width numbers keep the link texts on one vertical line. */
  .mobile__link .label {
    min-width: 1.25rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .mobile__link.is-active {
    color: var(--accent);
  }

  .mobile__cta {
    margin-top: 1.25rem;
    min-height: 2.75rem;
    font-size: 0.875rem;
  }

  /* The menu has its own contact button, so the header one steps aside while it is open. */
  .is-open .cta {
    display: none !important;
  }

  @media (min-width: 400px) {
    .cta {
      display: inline-flex;
    }
  }

  @media (max-width: 559px) {
    .brand__name {
      display: none;
    }
  }

  @media (min-width: 960px) {
    .nav {
      display: flex;
    }

    .menu-btn,
    .mobile {
      display: none !important;
    }

    .brand {
      margin-right: 1.5rem;
    }

    .tools {
      margin-left: auto;
    }
  }
</style>
